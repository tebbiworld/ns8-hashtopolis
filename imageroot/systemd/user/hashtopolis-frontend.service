# Hashtopolis Angular frontend. Its nginx is also the module's only entry
# point: the shipped configuration serves the single page application and
# reverse-proxies the backend paths to Apache on 127.0.0.1:80 inside the pod.
# It therefore listens on 8080 instead of the image default 80, which is taken
# by the backend in the same network namespace.

[Unit]
Description=Hashtopolis frontend
BindsTo=hashtopolis.service
After=hashtopolis.service hashtopolis-backend.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStartSec=120
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/hashtopolis-frontend.pid %t/hashtopolis-frontend.ctr-id
ExecStart=/usr/bin/podman run \
    --conmon-pidfile %t/hashtopolis-frontend.pid \
    --cidfile %t/hashtopolis-frontend.ctr-id \
    --cgroups=no-conmon \
    --pod-id-file %t/hashtopolis.pod-id \
    --replace -d --name hashtopolis-frontend \
    --volume %S/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro,Z \
    --env HASHTOPOLIS_BACKEND_URL=${BACKEND_URL} \
    ${FRONTEND_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/hashtopolis-frontend.ctr-id -t 30
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/hashtopolis-frontend.ctr-id
PIDFile=%t/hashtopolis-frontend.pid
Type=forking
SyslogIdentifier=%u

[Install]
WantedBy=default.target
