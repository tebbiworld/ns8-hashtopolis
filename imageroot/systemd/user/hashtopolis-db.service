# MySQL database for Hashtopolis. Runs inside the hashtopolis pod so the backend
# can reach it on 127.0.0.1:3306.
# MySQL 8.4 LTS: the accounts were created with mysql_native_password (the
# 8.0 option --default-authentication-plugin no longer exists); 8.4 keeps that
# plugin only when --mysql-native-password=ON is given, and
# --authentication-policy makes it the default for new accounts again, so a
# new installation or a restore gets the same plugin as an updated one. On the first start
# after the update from 8.0 MySQL upgrades the data directory in place, which
# may take a minute (TimeoutStartSec).

[Unit]
Description=Hashtopolis database
BindsTo=hashtopolis.service
After=hashtopolis.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
# Secrets are kept out of state/environment (mirrored to Redis).
EnvironmentFile=-%S/state/passwords.env
WorkingDirectory=%S/state
Restart=always
TimeoutStartSec=600
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/hashtopolis-db.pid %t/hashtopolis-db.ctr-id
ExecStart=/usr/bin/podman run \
    --conmon-pidfile %t/hashtopolis-db.pid \
    --cidfile %t/hashtopolis-db.ctr-id \
    --cgroups=no-conmon \
    --pod-id-file %t/hashtopolis.pod-id \
    --replace -d --name hashtopolis-db \
    --volume hashtopolis-db:/var/lib/mysql:Z \
    --env MYSQL_ROOT_PASSWORD \
    --env MYSQL_DATABASE=hashtopolis \
    --env MYSQL_USER=hashtopolis \
    --env MYSQL_PASSWORD \
    --health-cmd "mysqladmin ping -h 127.0.0.1 -u root --password=\"$$MYSQL_ROOT_PASSWORD\" || exit 1" \
    --health-interval 10s \
    --health-timeout 5s \
    --health-retries 12 \
    ${MYSQL_IMAGE} \
    --mysql-native-password=ON \
    --authentication-policy=mysql_native_password \
    --character-set-server=utf8mb4 \
    --collation-server=utf8mb4_unicode_ci
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/hashtopolis-db.ctr-id -t 60
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/hashtopolis-db.ctr-id
PIDFile=%t/hashtopolis-db.pid
Type=forking
SyslogIdentifier=%u

[Install]
WantedBy=default.target
