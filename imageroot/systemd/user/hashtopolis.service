# Main unit for the Hashtopolis module. It creates the rootless pod that hosts
# the database and the backend (they share the pod's localhost). The Angular
# frontend runs as a separate container because it also listens on port 80 and
# would otherwise clash with the backend inside the same network namespace.

[Unit]
Description=Hashtopolis pod
Requires=hashtopolis-db.service hashtopolis-backend.service hashtopolis-frontend.service
Before=hashtopolis-db.service hashtopolis-backend.service hashtopolis-frontend.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStartSec=120
ExecStartPre=/bin/rm -f %t/hashtopolis.pid %t/hashtopolis.pod-id
ExecStartPre=/usr/bin/podman pod create \
    --infra-conmon-pidfile %t/hashtopolis.pid \
    --pod-id-file %t/hashtopolis.pod-id \
    --name hashtopolis \
    --publish 127.0.0.1:${BACKEND_PORT}:80 \
    --sysctl net.ipv4.ip_unprivileged_port_start=0 \
    --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/hashtopolis.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/hashtopolis.pod-id -t 20
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/hashtopolis.pod-id
PIDFile=%t/hashtopolis.pid
Type=forking

[Install]
WantedBy=default.target
