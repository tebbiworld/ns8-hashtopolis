import sys
import json

import agent

data = json.load(sys.stdin)

host = data.get("host")
h2hs = data.get("http2https", True)
lets_encrypt = data.get("lets_encrypt", False)

agent.set_env("TRAEFIK_HOST", host)
agent.set_env("TRAEFIK_HTTP2HTTPS", h2hs)

# The Angular frontend calls the backend from the user's browser. Use a
# protocol-relative URL so the browser inherits the scheme the page was loaded
# with. This avoids mixed-content errors for plain http, https, and behind a
# TLS-terminating cross-node gateway (where the public scheme is https even if
# this node itself serves plain http).
agent.set_env("BACKEND_URL", f"//{host}/api/v2")

agent.dump_env()
