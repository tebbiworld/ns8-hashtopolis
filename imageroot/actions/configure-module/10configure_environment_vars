import sys
import json

import agent

data = json.load(sys.stdin)

host = data.get("host")
h2hs = data.get("http2https", True)
lets_encrypt = data.get("lets_encrypt", False)
public_url = (data.get("public_url") or "").strip().rstrip("/")

agent.set_env("TRAEFIK_HOST", host)
agent.set_env("TRAEFIK_HTTP2HTTPS", h2hs)
if "lets_encrypt" in data:
    # kept so restore-module can re-create the route with the same setting
    agent.set_env("TRAEFIK_LETS_ENCRYPT", data["lets_encrypt"])

# Public base URL of this instance. Hashtopolis has to embed absolute URLs in
# API answers (agent binary downloads, v2 pagination links) and in the agent
# registration URL shown by the frontend, so a concrete scheme is required.
#
# By default it is derived from the Traefik settings of this node. That is wrong
# when the instance is published through a gateway node which terminates TLS
# while this node itself serves plain http; for that case the administrator can
# override the whole base URL in the Settings page.
if public_url:
    base_url = public_url
else:
    scheme = "https" if (lets_encrypt or h2hs) else "http"
    base_url = f"{scheme}://{host}"

agent.set_env("PUBLIC_URL", public_url)
agent.set_env("BASE_URL", base_url)

# The Angular frontend reads this at startup (assets/config.json) and derives
# both the API endpoint and the agent registration URL from it.
agent.set_env("BACKEND_URL", f"{base_url}/api/v2")

