# Publish Hashtopolis through Traefik on a single host name.
#
# The Angular frontend is the catch-all (it serves the SPA), while the backend
# serves the API and a set of PHP endpoints at the document root that agents
# need (binary, file and hashlist downloads). Those paths are routed to the
# backend with a higher priority so they win over the frontend catch-all.

import os
import sys
import json

import agent

# Backend HTTP entry points that must reach hashtopolis-backend.
# (suffix used as the route instance key, request path)
BACKEND_PATHS = [
    ("api", "/api"),
    ("binaries", "/binaries"),
    ("agents", "/agents.php"),
    ("getfile", "/getFile.php"),
    ("gethashlist", "/getHashlist.php"),
    ("getfound", "/getFound.php"),
]

data = json.load(sys.stdin)

host = data["host"]
h2hs = data.get("http2https", True)
module_id = os.environ["MODULE_ID"]
backend_port = os.environ["BACKEND_PORT"]
frontend_port = os.environ["FRONTEND_PORT"]
backend_url = "http://127.0.0.1:" + backend_port

# Frontend: catch-all route on the host name.
frontend_route = {
    "instance": module_id,
    "url": "http://127.0.0.1:" + frontend_port,
    "host": host,
    "http2https": h2hs,
    "lets_encrypt_check": True,
    "lets_encrypt_cleanup": True,
    "priority": 2,
}
if "lets_encrypt" in data:
    frontend_route["lets_encrypt"] = data["lets_encrypt"]
agent.set_route(frontend_route)

# Backend: one higher-priority route per backend path.
for suffix, path in BACKEND_PATHS:
    backend_route = {
        "instance": f"{module_id}-{suffix}",
        "url": backend_url,
        "host": host,
        "path": path,
        "http2https": h2hs,
        "priority": 3,
    }
    if "lets_encrypt" in data:
        backend_route["lets_encrypt"] = data["lets_encrypt"]
    agent.set_route(backend_route)
