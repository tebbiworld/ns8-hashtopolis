# Publish Hashtopolis through Traefik with a single host route.
#
# Up to 1.0.1 the module created seven routes: a catch-all for the Angular
# frontend plus one higher-priority path route per backend endpoint. Splitting
# the paths is an internal matter of this module, it does not belong in the
# cluster reverse proxy, and it broke as soon as an endpoint was forgotten
# (/static, needed for the agent's 7zr download). The module now runs its own
# nginx inside the pod (see imageroot/nginx/default.conf) and exposes a single
# port, so one plain host route is enough.

import os
import sys
import json

import agent

data = json.load(sys.stdin)

host = data["host"]
h2hs = data.get("http2https", True)
module_id = os.environ["MODULE_ID"]
http_port = os.environ["HTTP_PORT"]

route = {
    "instance": module_id,
    "url": "http://127.0.0.1:" + http_port,
    "host": host,
    "http2https": h2hs,
    "lets_encrypt_check": True,
    "lets_encrypt_cleanup": True,
}
if "lets_encrypt" in data:
    route["lets_encrypt"] = data["lets_encrypt"]

agent.set_route(route)
