# The initial administrator password, on explicit request of the settings
# page (get-configuration never returns it). It is only valid until it is
# changed in the Hashtopolis UI.

import json
import os
import sys

import modsecrets

json.dump({"admin_username": os.getenv("ADMIN_USER", "admin"),
           "admin_password": modsecrets.get("ADMIN_PASSWORD")}, fp=sys.stdout)
