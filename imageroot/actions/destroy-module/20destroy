# Remove the Traefik route created by configure-module. Instances created by
# 1.0.x also had six per-path backend routes; they are dropped by the update
# hook, but delete them here as well so a direct uninstall of an old instance
# leaves nothing behind.

import os
import sys
import json

import agent
import agent.tasks

# stdin is consumed even if unused, to follow the action protocol.
json.load(sys.stdin)

default_traefik_id = agent.resolve_agent_id('traefik@node')
if default_traefik_id is None:
    sys.exit(2)

module_id = os.environ['MODULE_ID']
# Route instances created by 1.0.x, kept for cleanup only.
legacy_suffixes = ["api", "binaries", "agents", "getfile", "gethashlist", "getfound"]

for instance in [module_id] + [f"{module_id}-{s}" for s in legacy_suffixes]:
    response = agent.tasks.run(
        agent_id=default_traefik_id,
        action='delete-route',
        data={'instance': instance},
    )
    if instance == module_id:
        agent.assert_exp(response['exit_code'] == 0)
