import os
import sys
import json

import agent

config = {}

config["host"] = os.getenv("TRAEFIK_HOST", "")
config["http2https"] = os.getenv("TRAEFIK_HTTP2HTTPS") == "True"

route = agent.get_route(os.environ["MODULE_ID"])
config["lets_encrypt"] = route.get("lets_encrypt", False)

config["backend_url"] = os.getenv("BACKEND_URL", "")

# Initial admin credentials seeded on first start (valid until changed in the
# Hashtopolis UI).
config["admin_username"] = os.getenv("ADMIN_USER", "admin")
config["admin_password"] = os.getenv("ADMIN_PASSWORD", "")

json.dump(config, fp=sys.stdout)
