# Generate the initial environment for a fresh Hashtopolis instance: pick the
# published TCP port and create the database and admin secrets.

import os
import secrets

import agent

# The node allocates org.nethserver.tcp-ports-demand ports and exposes them as
# a comma-separated TCP_PORTS list. Since 1.1.0 the module publishes a single
# port: the frontend nginx serves the Angular application and proxies the
# backend paths inside the pod, so only one entry point is exposed.
tcp_ports = [p.strip() for p in os.environ.get("TCP_PORTS", "").split(",") if p.strip()]
agent.set_env("HTTP_PORT", tcp_ports[0])

# Database and application secrets.
agent.set_env("MYSQL_ROOT_PASSWORD", secrets.token_hex(16))
agent.set_env("MYSQL_PASSWORD", secrets.token_hex(16))
agent.set_env("ADMIN_USER", "admin")
agent.set_env("ADMIN_PASSWORD", secrets.token_urlsafe(12))

# Persist the environment for the systemd units.
agent.dump_env()
