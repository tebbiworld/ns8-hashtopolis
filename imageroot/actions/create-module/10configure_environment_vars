# Generate the initial environment for a fresh Hashtopolis instance: split the
# two allocated TCP ports into named variables and create the database and
# admin secrets.

import os
import secrets

import agent

# The node allocates org.nethserver.tcp-ports-demand ports and exposes them as
# a comma-separated TCP_PORTS list. The first one publishes the backend, the
# second the Angular frontend.
tcp_ports = [p.strip() for p in os.environ.get("TCP_PORTS", "").split(",") if p.strip()]
backend_port = tcp_ports[0]
frontend_port = tcp_ports[1] if len(tcp_ports) > 1 else str(int(backend_port) + 1)

agent.set_env("BACKEND_PORT", backend_port)
agent.set_env("FRONTEND_PORT", frontend_port)

# Database and application secrets.
agent.set_env("MYSQL_ROOT_PASSWORD", secrets.token_hex(16))
agent.set_env("MYSQL_PASSWORD", secrets.token_hex(16))
agent.set_env("ADMIN_USER", "admin")
agent.set_env("ADMIN_PASSWORD", secrets.token_urlsafe(12))

# Persist the environment for the systemd units.
agent.dump_env()
