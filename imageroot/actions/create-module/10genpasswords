# Generate the secrets into state/passwords.env (mode 0600): they must not be
# stored in state/environment, which NS8 mirrors to Redis in plain text.

import secrets

import modsecrets

modsecrets.ensure({
    "MYSQL_ROOT_PASSWORD": secrets.token_hex(16),
    "MYSQL_PASSWORD": secrets.token_hex(16),
    # Initial password of the Hashtopolis "admin" account.
    "ADMIN_PASSWORD": secrets.token_urlsafe(12),
})
# The backend container expects the same values under its own variable names.
pw = modsecrets.read()
modsecrets.write({
    "HASHTOPOLIS_DB_PASS": pw["MYSQL_PASSWORD"],
    "HASHTOPOLIS_ADMIN_PASSWORD": pw["ADMIN_PASSWORD"],
})
