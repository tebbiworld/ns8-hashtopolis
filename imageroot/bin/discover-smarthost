# ExecStartPre of hashtopolis-backend (through runagent): write
# state/ssmtp/ssmtp.conf from the cluster smarthost. Hashtopolis sends mail
# (e-mail notifications, password reset) with PHP mail(), which runs the
# image's ssmtp; without this file those mails were silently lost.
# The file holds the relay password: mode 0640, group "mail" inside the
# container (ssmtp is setgid mail, PHP runs as www-data).

import os
import subprocess
import sys

import agent

rdb = agent.redis_connect(use_replica=True)
sh = agent.get_smarthost_settings(rdb)
host = os.environ.get("TRAEFIK_HOST", "") or "localhost"
domain = host.split(".", 1)[1] if host.count(".") > 1 else host

os.makedirs("ssmtp", exist_ok=True)
lines = ["# Generated by bin/discover-smarthost from the cluster smarthost. Do not edit by hand."]
if sh.get("enabled") and sh.get("host"):
    lines += [
        f"mailhub={sh['host']}:{sh.get('port') or 587}",
        f"hostname={host}",
        f"rewriteDomain={domain}",
        "FromLineOverride=YES",
    ]
    if sh.get("encrypt_smtp") == "starttls":
        lines.append("UseSTARTTLS=YES")
    elif sh.get("encrypt_smtp") == "tls":
        lines.append("UseTLS=YES")
    if sh.get("username"):
        password = sh.get("password") or ""
        if any(c in password for c in "\n#"):
            print(agent.SD_WARNING + "smarthost password contains '#' or a line break, which ssmtp cannot read: mail may fail", file=sys.stderr)
        lines += [f"AuthUser={sh['username']}", f"AuthPass={password}"]
else:
    # no relay: ssmtp refuses to send, PHP mail() reports the failure
    lines.append("mailhub=localhost:25")
    print(agent.SD_NOTICE + "no cluster smarthost: Hashtopolis cannot send mail", file=sys.stderr)

old_umask = os.umask(0o077)
try:
    with open("ssmtp/ssmtp.conf.tmp", "w") as fp:
        fp.write("\n".join(lines) + "\n")
    os.chmod("ssmtp/ssmtp.conf.tmp", 0o640)
    # root:mail inside the rootless user namespace (mail = gid 8 in the image)
    subprocess.run(["podman", "unshare", "chown", "0:8", "ssmtp/ssmtp.conf.tmp"], check=True)
    os.replace("ssmtp/ssmtp.conf.tmp", "ssmtp/ssmtp.conf")
finally:
    os.umask(old_umask)
