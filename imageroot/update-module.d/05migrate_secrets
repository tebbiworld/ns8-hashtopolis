# Up to 1.1.1 the secrets were stored with agent.set_env(), i.e. in
# state/environment, which the agent mirrors to Redis in plain text. Move them
# to state/passwords.env (0600); the values do not change.

import modsecrets

modsecrets.migrate_from_env(
    ["MYSQL_ROOT_PASSWORD", "MYSQL_PASSWORD", "ADMIN_PASSWORD"],
    aliases={"HASHTOPOLIS_DB_PASS": "MYSQL_PASSWORD", "HASHTOPOLIS_ADMIN_PASSWORD": "ADMIN_PASSWORD"},
)
