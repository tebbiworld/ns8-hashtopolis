#
# An update does not run configure-module, so refresh the Hashtopolis
# "baseHost" setting here as well. Without it an instance updated from 1.0.x
# would keep handing out http download URLs until the administrator saves the
# module settings once.
#

set -e

# Redirect any output to the journal (stderr)
exec 1>&2

"${AGENT_INSTALL_DIR}"/bin/apply-base-host
